EXTRACTOR='docling'
EXPORT_FORMAT='markdown'
SOURCE_DATA_PATH='data'
ENABLE_OCR=False
ENABLE_TABLES=False

# Docling Configuration
DOCLING_DISABLE_OCR=false
DOCLING_DISABLE_TABLE_DETECTION=false
HF_HUB_DISABLE_TELEMETRY=1

# Database Configuration (Docker internal networking)
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=admin
DATABASE_NAME=agentic-rag
DIM=768

# Ollama Configuration (Docker internal networking)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_API_BASE=http://host.docker.internal:11434

# Phoenix Configuration
PHOENIX_COLLECTOR_ENDPOINT=http://phoenix:6006

# RAG API Configuration
RAG_API_BASE_URL=http://rag-api:8000

EMBEDDING_LLM="nomic-embed-text:v1.5"
LLM="gemma3:4b"
